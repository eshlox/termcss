{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @eshlox/termcss build && pnpm --filter term.css-docs build",
    "build:css": "pnpm --filter @eshlox/termcss build:css",
    "build:themes": "pnpm --filter @eshlox/termcss build:themes",
    "dev": "pnpm --filter term.css-docs dev",
    "test": "node --test packages/termcss/scripts/*.test.js scripts/*.test.mjs",
    "check": "node scripts/check-consistency.mjs && node scripts/check-contrast.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "changeset": "changeset",
    "release": "pnpm --filter @eshlox/termcss build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
